{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "src/worker/index.ts",
	"name": "spotify",
	"workers_dev": true,
	"compatibility_date": "2026-07-09",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"triggers": {
		"crons": ["*/15 * * * *"]
	},
	"assets": {
		"binding": "ASSETS",
		"not_found_handling": "single-page-application",
		"run_worker_first": true
	},
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "spotify-db",
			"database_id": "88a7aea6-ab87-43e9-a728-bca750986ccc",
			"migrations_dir": "db/d1-migrations"
		}
	],
	"r2_buckets": [
		{
			"binding": "MEDIA",
			"bucket_name": "spotify-media"
		}
	],
	"images": {
		"binding": "IMAGES"
	},
	"send_email": [
		{
			"name": "EMAIL"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.01
		}
	},
	"vars": {
		"PLAYLISTS_EDITABLE": "1",
		"AUTH_TRUST_HOST": "true",
		"EMAIL_FROM": "noreply@streamarena.xyz",
		"APP_ORIGIN": "https://music.streamarena.xyz",
		"MAC_MINI_ORIGIN": "https://music.streamarena.xyz",
		"SPOTIFLAC_PROVIDER_ORDER": "tidal-qobuz-amazon-deezer-apple",
		"SPOTIFLAC_TIDAL_APIS": "https://tdl-oss.spotbye.qzz.io",
		"SPOTIFLAC_ACTIVE_TIDAL_API": "https://tdl-oss.spotbye.qzz.io"
	}
}
